# Evolution do Publiva (Lightsail). A chave está no SSM /publiva/evolution/apikey
# (ou na env EVOLUTION_API_KEY da Lambda publiva-api).
EVOLUTION_API_URL="https://evolution.publiva.com.br"
EVOLUTION_API_KEY=""

# Instância própria deste projeto — não reaproveita as publiva-* dos clientes.
EVOLUTION_INSTANCE="freela"

# Trava de segurança: só estes números recebem mensagem (vírgula separa).
DESTINOS_PERMITIDOS=""

# Ollama local (rascunho da mensagem)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
MEU_NOME="Gustavo"

# Chrome em debug e porta do painel
CHROME_DEBUG_PORT="9222"
PORTA="3737"
